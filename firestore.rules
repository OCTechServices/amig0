// firestore.rules — amig0-travel-company | OCTech Services
// Last Updated: 2026-08-23
//
// Operator access: Firebase Auth custom claim { operator: true }
//   Bootstrap: Firebase Console → Authentication → Users → Edit → Custom Claims: {"operator":true}
//   After bootstrap, use CRM → Operators module to manage operator accounts.
//
// Client access:  user_profiles/{uid} with role == 'client' + clientId scoping
// Guide access:   user_profiles/{uid} with role == 'guide'
//
// To make someone a client: add to user_profiles
//   Document ID = Firebase Auth UID
//   { role: "client", clientId: "<clients doc ID>" }
//
// To make someone a guide: add to user_profiles
//   Document ID = Firebase Auth UID
//   { role: "guide", guideId: "<guides doc ID>" }

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Helpers
    // -----------------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOperator() {
      return isAuthenticated() && request.auth.token.operator == true;
    }

    function isClientUser() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/user_profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.role == 'client';
    }

    function isGuideUser() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/user_profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.role == 'guide';
    }

    function isClientOrGuide() {
      return isClientUser() || isGuideUser();
    }

    function clientId() {
      return get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.clientId;
    }

    function guideRecordId() {
      return get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.guideId;
    }

    // Returns true when the signed-in user has an active or valid-trial membership.
    // Used as server-side enforcement for deal_redemptions — client-side isAccessAllowed()
    // is a UX gate only; this rule is the real lock.
    function isMemberAllowed() {
      let m = get(/databases/$(database)/documents/amig0_members/$(request.auth.uid)).data;
      return m.subscriptionStatus == 'active'
        || (m.subscriptionStatus == 'trial' && m.trialEndsAt > request.time);
    }

    // Returns true when the user has NOT redeemed from this affiliate in the last 30 days.
    // Reads sentinel at amig0_members/{uid}/redemptions/{affiliateId}.
    // Client batch-writes this sentinel on every successful redemption (C3).
    function isNotRecentlyRedeemed() {
      let path = /databases/$(database)/documents/amig0_members/$(request.auth.uid)/redemptions/$(request.resource.data.affiliateId);
      return !exists(path)
        || get(path).data.redeemedAt < request.time - duration.value(30, 'd');
    }

    // -----------------------------------------------------------------------
    // user_profiles — each user reads and writes only their own profile.
    // Operator provisioning (creating client/guide profiles) is done via
    // Firebase Console, which bypasses rules.
    // -----------------------------------------------------------------------
    match /user_profiles/{uid} {
      allow read:  if isAuthenticated() && request.auth.uid == uid;
      allow write: if isAuthenticated() && request.auth.uid == uid;
    }

    // -----------------------------------------------------------------------
    // operators — read by operators; writes managed by Cloud Function only
    // -----------------------------------------------------------------------
    match /operators/{uid} {
      allow read:  if isOperator();
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // clients
    // -----------------------------------------------------------------------
    match /clients/{docId} {
      allow read, write: if isOperator();
      allow read:        if isClientUser() && clientId() == docId;
    }

    // -----------------------------------------------------------------------
    // tours
    // Guides can only read their assigned tour (guideId field on tour doc).
    // -----------------------------------------------------------------------
    match /tours/{tourId} {
      allow read, write: if isOperator();
      allow read:        if isClientUser();
      allow read:        if isGuideUser() && resource.data.guideId == guideRecordId();
    }

    match /tours/{tourId}/itineraries/{dayId} {
      allow read, write: if isOperator();
      allow read:        if isClientUser();
      allow read:        if isGuideUser() &&
        get(/databases/$(database)/documents/tours/$(tourId)).data.guideId == guideRecordId();
    }

    // -----------------------------------------------------------------------
    // passengers
    // Client portal reads passenger names for fellow travellers.
    // Guide app fetches passengers by booking-filtered IDs (in-query by doc ID).
    // Rules-level scoping requires a tourId on the passenger doc — not yet
    // denormalized. Guide app scopes in JS. Accepted for single-tenant. (RAID I10)
    // -----------------------------------------------------------------------
    match /passengers/{docId} {
      allow read, write: if isOperator();
      allow read:        if isClientOrGuide();
    }

    // -----------------------------------------------------------------------
    // bookings
    // Client portal reads all bookings on a tour for fellow travellers (RAID I06).
    // Guides can only read bookings for their assigned tour (via tour guideId lookup).
    // -----------------------------------------------------------------------
    match /bookings/{docId} {
      allow read, write: if isOperator();
      allow read:        if isClientUser();
      allow read:        if isGuideUser() &&
        get(/databases/$(database)/documents/tours/$(resource.data.tourId)).data.guideId == guideRecordId();
    }

    // -----------------------------------------------------------------------
    // quotes
    // -----------------------------------------------------------------------
    match /quotes/{docId} {
      allow read, write: if isOperator();
      allow read:        if isClientUser() && clientId() == resource.data.clientId;
    }

    // -----------------------------------------------------------------------
    // invoices
    // -----------------------------------------------------------------------
    match /invoices/{docId} {
      allow read, write: if isOperator();
      allow read:        if isClientUser() && clientId() == resource.data.clientId;
    }

    match /invoices/{invoiceId}/payments/{paymentId} {
      allow read, write: if isOperator();
    }

    // -----------------------------------------------------------------------
    // guides
    // -----------------------------------------------------------------------
    match /guides/{docId} {
      allow read, write: if isOperator();
      allow read:        if isGuideUser();
    }

    // -----------------------------------------------------------------------
    // providers
    // -----------------------------------------------------------------------
    match /providers/{docId} {
      allow read, write: if isOperator();
    }

    // -----------------------------------------------------------------------
    // briefings
    // -----------------------------------------------------------------------
    match /briefings/{docId} {
      allow read, write: if isOperator();
      allow read:        if isClientUser() && resource.data.type == 'client';
      allow read:        if isGuideUser()  && resource.data.type == 'guide';
    }

    // -----------------------------------------------------------------------
    // documents
    // -----------------------------------------------------------------------
    match /documents/{docId} {
      allow read, write: if isOperator();
      allow read:        if isClientUser() && clientId() == resource.data.clientId;
    }

    // -----------------------------------------------------------------------
    // partners — operator manages; authenticated clients can read (for portal map)
    // -----------------------------------------------------------------------
    match /partners/{docId} {
      allow read, write: if isOperator();
      allow read:        if isClientOrGuide();
    }

    // -----------------------------------------------------------------------
    // marketplace_listings — operator manages; clients with access can read
    // -----------------------------------------------------------------------
    match /marketplace_listings/{docId} {
      allow read, write: if isOperator();
      allow read:        if isClientUser() &&
        get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.marketplaceAccess == true;
    }

    // -----------------------------------------------------------------------
    // invites — operator creates; client can read (for validation) and update
    //           own redemption fields only
    // -----------------------------------------------------------------------
    match /invites/{docId} {
      allow read, write: if isOperator();
      allow read:        if isClientUser();
      allow update:      if isClientUser() &&
        request.resource.data.usedByUid == request.auth.uid &&
        resource.data.usedByUid == null;
    }

    // -----------------------------------------------------------------------
    // checkins — clients write and read their own; operators read all
    // -----------------------------------------------------------------------
    match /checkins/{docId} {
      allow read, write: if isOperator();
      allow create:      if isClientUser() && request.resource.data.userId == request.auth.uid;
      allow read:        if isClientUser() && resource.data.userId == request.auth.uid;
    }

    // -----------------------------------------------------------------------
    // amig0_members — consumer users (deals app, trial + subscription tracking)
    // -----------------------------------------------------------------------
    match /amig0_members/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
      allow read:        if isOperator();
    }

    // redemptions sentinel — one doc per affiliate, records last redeemedAt.
    // Written by the client in a batch alongside deal_redemptions (C3).
    // The deal_redemptions create rule reads this path via isNotRecentlyRedeemed().
    match /amig0_members/{uid}/redemptions/{affiliateId} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
      allow read:        if isOperator();
    }

    // -----------------------------------------------------------------------
    // affiliates — public directory of active affiliate businesses
    // Publicly readable so deals.html and hacks can display without auth.
    // -----------------------------------------------------------------------
    match /affiliates/{docId} {
      allow read:  if true;
      allow write: if isOperator();
    }

    // -----------------------------------------------------------------------
    // affiliates/secrets — verifyPin stored here, operator-only.
    // The verifyPin value NEVER travels to the client.
    // Validation happens inside the deal_redemptions create rule via get().
    // -----------------------------------------------------------------------
    match /affiliates/{affiliateId}/secrets/{secretDoc} {
      allow read, write: if isOperator();
    }

    // -----------------------------------------------------------------------
    // affiliate_registrations — self-service venue signup
    // Anyone can submit; operator reviews and approves in CRM.
    // -----------------------------------------------------------------------
    match /affiliate_registrations/{docId} {
      allow create: if request.resource.data.keys().hasAll(['businessName', 'email'])
        && request.resource.data.businessName is string
        && request.resource.data.email is string;
      allow read, write: if isOperator();
    }

    // -----------------------------------------------------------------------
    // deal_redemptions — consumer redemption log
    // Three server-side checks on create:
    //   1. userId matches signed-in uid (no impersonation)
    //   2. PIN matches affiliates/{id}/secrets/verify — verifyPin never leaves server
    //   3. isMemberAllowed() — active subscription OR unexpired trial (C2)
    // -----------------------------------------------------------------------
    match /deal_redemptions/{docId} {
      allow read, write: if isOperator();
      allow create:      if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.pin ==
             get(/databases/$(database)/documents/affiliates/$(request.resource.data.affiliateId)/secrets/verify).data.verifyPin
        && isMemberAllowed()
        && isNotRecentlyRedeemed();
      allow read:        if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }
  }
}
