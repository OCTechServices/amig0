// firestore.rules — amig0-travel-company | OCTech Services
// Last Updated: 2026-04-19
//
// Role model (enforced via user_profiles collection):
//   operator — CRM users, full read/write
//   client   — portal users, read-only on their own data (scoped by clientId)
//   guide    — guide app users, read-only on assigned tour data
//
// user_profiles/{uid} must exist for every Firebase Auth user.
// Operators must be created manually in user_profiles by another operator.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Helpers
    // -----------------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data;
    }

    function isOperator() {
      return isAuthenticated() && profile().role == 'operator';
    }

    function isClientUser() {
      return isAuthenticated() && profile().role == 'client';
    }

    function isGuideUser() {
      return isAuthenticated() && profile().role == 'guide';
    }

    // -----------------------------------------------------------------------
    // user_profiles
    // Each Firebase Auth user must have a profile doc (ID = UID).
    // Only operators can create/update profiles — no self-registration.
    // -----------------------------------------------------------------------
    match /user_profiles/{uid} {
      allow read:  if isAuthenticated() && request.auth.uid == uid;
      allow write: if isOperator();
    }

    // -----------------------------------------------------------------------
    // clients
    // Operators: full access
    // Clients: read their own record only (profile.clientId == document ID)
    // -----------------------------------------------------------------------
    match /clients/{clientId} {
      allow read, write: if isOperator();
      allow read:        if isClientUser() && profile().clientId == clientId;
    }

    // -----------------------------------------------------------------------
    // tours
    // Operators: full access
    // Clients + guides: read (further scoped at booking level in the app)
    // -----------------------------------------------------------------------
    match /tours/{tourId} {
      allow read, write: if isOperator();
      allow read:        if isClientUser() || isGuideUser();
    }

    // tours → itineraries sub-collection
    match /tours/{tourId}/itineraries/{dayId} {
      allow read, write: if isOperator();
      allow read:        if isClientUser() || isGuideUser();
    }

    // -----------------------------------------------------------------------
    // passengers
    // Operators: full access
    // Clients: read passengers linked to their clientId
    // Guides: read-only (to see their tour's passenger list)
    // -----------------------------------------------------------------------
    match /passengers/{docId} {
      allow read, write: if isOperator();
      allow read:        if isClientUser() && profile().clientId == resource.data.clientId;
      allow read:        if isGuideUser();
    }

    // -----------------------------------------------------------------------
    // bookings
    // Operators: full access
    // Clients: read bookings linked to their clientId
    // Guides: read-only (to see who is on their tour)
    // -----------------------------------------------------------------------
    match /bookings/{docId} {
      allow read, write: if isOperator();
      allow read:        if isClientUser() && profile().clientId == resource.data.clientId;
      allow read:        if isGuideUser();
    }

    // -----------------------------------------------------------------------
    // quotes
    // Operators: full access
    // Clients: read their own quotes only
    // -----------------------------------------------------------------------
    match /quotes/{docId} {
      allow read, write: if isOperator();
      allow read:        if isClientUser() && profile().clientId == resource.data.clientId;
    }

    // -----------------------------------------------------------------------
    // invoices
    // Operators: full access
    // Clients: read their own invoices only
    // -----------------------------------------------------------------------
    match /invoices/{docId} {
      allow read, write: if isOperator();
      allow read:        if isClientUser() && profile().clientId == resource.data.clientId;
    }

    // invoices → payments sub-collection (future)
    match /invoices/{invoiceId}/payments/{paymentId} {
      allow read, write: if isOperator();
      allow read:        if isClientUser();
    }

    // -----------------------------------------------------------------------
    // providers
    // Operators only — never exposed to clients or guides
    // -----------------------------------------------------------------------
    match /providers/{docId} {
      allow read, write: if isOperator();
    }

    // -----------------------------------------------------------------------
    // briefings
    // Operators: full access
    // Clients: read briefings of type 'client' only
    // Guides: read briefings of type 'guide' only
    // -----------------------------------------------------------------------
    match /briefings/{docId} {
      allow read, write: if isOperator();
      allow read:        if isClientUser() && resource.data.type == 'client';
      allow read:        if isGuideUser()  && resource.data.type == 'guide';
    }

    // -----------------------------------------------------------------------
    // documents (generated PDFs — Firebase Storage refs)
    // Operators: full access
    // Clients: read their own documents
    // -----------------------------------------------------------------------
    match /documents/{docId} {
      allow read, write: if isOperator();
      allow read:        if isClientUser() && profile().clientId == resource.data.clientId;
    }
  }
}
