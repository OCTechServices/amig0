{
  "version": 2,
  "routes": [
    { "src": "/favicon.ico", "headers": { "Location": "/favicon.svg" }, "status": 301 },
    { "src": "^/$", "dest": "/home.html" },
    { "src": "^/deals/?$", "dest": "/deals.html" },
    { "src": "^/business/?$", "dest": "/business.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "functions": {
    "api/ig-post.py": { "maxDuration": 60 }
  }
}
